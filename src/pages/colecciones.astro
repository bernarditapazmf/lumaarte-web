<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style is:global>
@font-face{font-family:'Mackinac';src:url('/fonts/Mackinac-Book.otf') format('opentype');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Mackinac';src:url('/fonts/Mackinac-BookItalic.otf') format('opentype');font-weight:400;font-style:italic;font-display:swap}
@font-face{font-family:'Mackinac';src:url('/fonts/Mackinac-Medium.otf') format('opentype');font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:'Mackinac';src:url('/fonts/Mackinac-MediumItalic.otf') format('opentype');font-weight:500;font-style:italic;font-display:swap}
@font-face{font-family:'CoFo Sans';src:url('/fonts/CoFoSans-Light.otf') format('opentype');font-weight:300;font-style:normal;font-display:swap}
@font-face{font-family:'CoFo Sans';src:url('/fonts/CoFoSans-Regular.otf') format('opentype');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'CoFo Sans';src:url('/fonts/CoFoSans-Italic.otf') format('opentype');font-weight:400;font-style:italic;font-display:swap}
@font-face{font-family:'CoFo Sans';src:url('/fonts/CoFoSans-Medium.otf') format('opentype');font-weight:500;font-style:normal;font-display:swap}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-x:hidden}
body{background:#FDFCF8;font-family:'CoFo Sans',system-ui,sans-serif;color:#211f18;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:#54582f}
a:hover{color:#3c3f21}

@keyframes lumaDrift{0%{transform:scale(1.08) translate(0,0)}50%{transform:scale(1.15) translate(-1.2%,-1%)}100%{transform:scale(1.08) translate(0,0)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important}}

/* NAV */
.nav{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:26px 48px;z-index:20}
.nav-logo{height:60px;width:104px;filter:brightness(0) invert(1);opacity:.97;object-fit:contain}
.nav-links{display:flex;align-items:center;gap:36px}
.nav-link{font:500 12px/1 'Spline Sans Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#fdfcf8;text-decoration:none;padding-bottom:3px;border-bottom:1px solid transparent;transition:border-color .2s}
.nav-link:hover{border-bottom-color:rgba(253,252,248,.7)}
.nav-link--active{border-bottom-color:rgba(253,252,248,.8)}
.nav-cart{display:flex;align-items:center;gap:8px;background:none;border:none;color:#fdfcf8;padding:6px 2px;cursor:pointer}
.nav-cart:hover{opacity:.8}

/* HERO */
.hero{position:relative;min-height:64vh;overflow:hidden;background:#20241a}
.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;animation:lumaDrift 52s ease-in-out infinite}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,22,14,.5) 0%,rgba(20,22,14,.14) 32%,rgba(20,22,14,.2) 56%,rgba(20,22,14,.66) 100%)}
.hero-body{position:absolute;left:48px;right:48px;bottom:64px;z-index:10}
.hero-eyebrow{font:500 12px/1 'Spline Sans Mono',monospace;letter-spacing:.34em;text-transform:uppercase;color:rgba(253,252,248,.85);margin-bottom:24px}
.hero-h1{font-family:'Mackinac',serif;font-weight:400;font-size:clamp(38px,5.4vw,68px);line-height:1.04;letter-spacing:-.02em;color:#fdfcf8;max-width:18ch}
.hero-sub{margin:24px 0 0;font:300 17px/1.6 'CoFo Sans';color:rgba(253,252,248,.92);max-width:48ch}

/* LA COLECCIÓN (obras) */
.pinturas{padding:104px 52px 40px;scroll-margin-top:10px;max-width:1300px;margin:0 auto}
.pinturas-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:46px;border-bottom:.5px solid rgba(33,31,24,.2);padding-bottom:24px}
.pinturas-eyebrow{font:500 12px/1 'Spline Sans Mono',monospace;letter-spacing:.3em;text-transform:uppercase;color:#54582f;margin-bottom:18px}
.pinturas-h2{font-family:'Mackinac',serif;font-weight:400;font-size:48px;line-height:1;letter-spacing:-.02em}
.pinturas-sub{margin-top:14px;font:300 15px/1.7 'CoFo Sans';color:rgba(33,31,24,.6);max-width:52ch}
.obras-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:44px 32px}
.obra-cell{display:block}
.obra-cell--horizontal{grid-column:span 2}
.obra-frame{position:relative;overflow:hidden;border-radius:4px;background:transparent;cursor:pointer}
.obra-frame--vertical{aspect-ratio:106/150}
.obra-frame--horizontal{aspect-ratio:900/635}
.obra-frame--vendida{cursor:default}
.obra-img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 1.1s cubic-bezier(.16,1,.3,1)}
.obra-frame:not(.obra-frame--vendida):hover .obra-img,.obra-frame.is-open .obra-img{transform:scale(1.55)}
.obra-badge{position:absolute;left:14px;top:14px;z-index:4;display:flex;align-items:center;gap:7px;padding:6px 11px;border-radius:60px;background:rgba(253,252,248,.92);backdrop-filter:blur(3px);transition:opacity .3s ease}
.obra-badge.hidden{opacity:0;pointer-events:none}
.obra-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.obra-dot--disp{background:#54582f}
.obra-dot--vend{background:rgba(120,110,90,.55)}
.obra-badge-txt{font:500 10px/1 'Spline Sans Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#211f18}
.obra-overlay{position:absolute;inset:0;z-index:3;padding:24px 22px;display:flex;flex-direction:column;justify-content:space-between;background:rgba(16,18,10,.58);backdrop-filter:blur(1px);opacity:0;visibility:hidden;transition:opacity .35s ease,visibility .35s;box-sizing:border-box}
.obra-overlay.active{opacity:1;visibility:visible}
.obra-sizes-label{font:500 10px/1 'Spline Sans Mono',monospace;letter-spacing:.26em;text-transform:uppercase;color:rgba(253,252,248,.7);margin-bottom:14px}
.obra-sizes{display:flex;flex-direction:column;gap:8px}
.obra-size-btn{width:100%;text-align:left;padding:12px 14px;border-radius:10px;font:500 12px/1 'Spline Sans Mono',monospace;letter-spacing:.06em;border:1px solid rgba(253,252,248,.35);background:rgba(253,252,248,.1);color:#fdfcf8;transition:all .2s ease}
.obra-size-btn:hover{background:rgba(253,252,248,.22);border-color:rgba(253,252,248,.65)}
.obra-size-btn.selected{border-color:#fdfcf8;background:rgba(253,252,248,.94);color:#211f18}
.obra-overlay-bottom{display:flex;align-items:center;justify-content:flex-end;gap:14px}
.obra-cerrar{background:none;border:none;color:rgba(253,252,248,.7);font:400 11px/1 'Spline Sans Mono',monospace;letter-spacing:.1em;text-transform:uppercase;padding:4px 0}
.obra-cerrar:hover{color:#fdfcf8}
.obra-comprar{padding:13px 24px;border-radius:60px;border:none;background:#fdfcf8;color:#211f18;font:500 11px/1 'Spline Sans Mono',monospace;letter-spacing:.14em;text-transform:uppercase;box-shadow:0 4px 16px rgba(8,10,4,.35);transition:transform .2s,box-shadow .2s}
.obra-comprar:hover{transform:scale(1.04);box-shadow:0 6px 22px rgba(8,10,4,.45)}
.obra-info{padding-top:18px}
.obra-title{font-family:'Mackinac',serif;font-size:20px;font-weight:400;line-height:1.2}
.obra-desc{font:400 12.5px/1.55 'CoFo Sans';color:rgba(33,31,24,.5);margin-top:5px}
.obra-mat-label{font:500 9px/1 'Spline Sans Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:rgba(33,31,24,.38);margin-bottom:10px;margin-top:16px}
.obra-mat-btns{display:flex;gap:8px}
.obra-mat-btn{padding:10px 20px;border-radius:8px;font:500 10px/1 'Spline Sans Mono',monospace;letter-spacing:.12em;text-transform:uppercase;border:1.5px solid rgba(33,31,24,.22);background:transparent;color:rgba(33,31,24,.55);transition:all .2s ease}
.obra-mat-btn.active{border-color:#211f18;background:#211f18;color:#fdfcf8}

/* FOTO BORDADO */
.bordado{padding:112px 52px 108px;scroll-margin-top:10px;background:#F3F0E9}
.bordado-inner{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px}
.bordado-eyebrow{font:500 12px/1 'Spline Sans Mono',monospace;letter-spacing:.3em;text-transform:uppercase;color:#54582f;margin-bottom:18px}
.bordado-h2{font-family:'Mackinac',serif;font-weight:400;font-size:clamp(30px,3.5vw,44px);line-height:1.08;letter-spacing:-.02em;margin-bottom:20px}
.bordado-sub{font:300 16px/1.75 'CoFo Sans';color:rgba(33,31,24,.7);max-width:48ch;margin-bottom:36px}
.bordado-steps{display:flex;flex-direction:column;gap:20px;margin-bottom:40px}
.bordado-step{display:flex;gap:16px}
.bordado-step-num{flex:none;width:30px;height:30px;border-radius:50%;background:#211f18;color:#fdfcf8;font:500 12px/1 'Spline Sans Mono',monospace;display:flex;align-items:center;justify-content:center}
.bordado-step-txt{font:300 15px/1.6 'CoFo Sans';color:rgba(33,31,24,.75);padding-top:4px}
.bordado-step-txt strong{font-weight:500;color:#211f18}
.bordado-maderas-label{font:500 11px/1 'Spline Sans Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:rgba(33,31,24,.5);margin-bottom:14px}
.bordado-maderas{display:flex;flex-wrap:wrap;gap:10px}
.bordado-madera{padding:9px 18px;border-radius:60px;border:1px solid rgba(33,31,24,.2);font:400 13px 'CoFo Sans';color:#211f18;background:#fdfcf8}
.bordado-form{background:#fdfcf8;border:.5px solid rgba(33,31,24,.12);border-radius:16px;padding:40px 36px}
.bordado-form-h3{font-family:'Mackinac',serif;font-size:22px;font-weight:400;margin-bottom:8px}
.bordado-form-sub{font:300 14px/1.6 'CoFo Sans';color:rgba(33,31,24,.55);margin-bottom:28px}
.bf-field{margin-bottom:18px}
.bf-label{display:block;font:500 11px/1 'Spline Sans Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:rgba(33,31,24,.55);margin-bottom:8px}
.bf-input,.bf-select,.bf-textarea{width:100%;background:transparent;border:none;border-bottom:.5px solid rgba(33,31,24,.35);padding:11px 2px;font:400 15px 'CoFo Sans';color:#211f18;outline:none;font-family:inherit}
.bf-textarea{resize:none}
.bf-select{background:#fdfcf8}
.bf-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.bf-submit{margin-top:8px;width:100%;padding:16px;border-radius:60px;border:none;background:#211f18;color:#fdfcf8;font:500 12px/1 'Spline Sans Mono',monospace;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:background .2s}
.bf-submit:hover{background:#54582f}
.bf-submit:disabled{opacity:.6;cursor:default}
.bf-msg{margin-top:16px;font:400 14px/1.6 'CoFo Sans'}
.bf-msg.ok{color:#54582f}
.bf-msg.err{color:#a33}

/* FOOTER */
.footer{background:#211f18;color:#f3f0e9;padding:64px 48px 38px}
.footer-inner{max-width:1000px;margin:0 auto}
.footer-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:36px;padding-bottom:42px;border-bottom:.5px solid rgba(243,240,233,.18)}
.footer-logo{height:52px;filter:brightness(0) invert(1);opacity:.95}
.footer-tagline{margin:22px 0 0;font:300 14px/1.7 'CoFo Sans';color:rgba(243,240,233,.65)}
.footer-links{display:flex;gap:64px}
.footer-col-label{font:500 11px/1 'Spline Sans Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:rgba(243,240,233,.5);margin-bottom:14px}
.footer-email{display:block;color:#f3f0e9;text-decoration:none;font:400 15px 'CoFo Sans'}
.footer-email:hover{color:#cdd3ae}
.footer-address{margin-top:8px;font:300 13px/1.6 'CoFo Sans';color:rgba(243,240,233,.55)}
.footer-ig{display:inline-flex;align-items:center;gap:10px;color:#f3f0e9;text-decoration:none;font:400 15px 'CoFo Sans'}
.footer-ig:hover{color:#cdd3ae}
.footer-copy{padding-top:22px;font:400 11.5px/1 'CoFo Sans';color:rgba(243,240,233,.45)}

/* RESPONSIVE */
@media(max-width:900px){
  .nav{padding:20px 24px}
  .nav-links{gap:20px}
  .nav-link{font-size:10px}
  .hero-body{left:24px;right:24px;bottom:48px}
  .pinturas{padding:72px 24px 40px}
  .obras-grid{grid-template-columns:1fr 1fr;gap:28px 20px}
  .obra-cell--horizontal{grid-column:span 2}
  .bordado{padding:72px 24px 80px}
  .bordado-inner{grid-template-columns:1fr;gap:44px}
  .bordado-form{padding:32px 26px}
  .footer{padding:48px 24px 32px}
  .footer-top{flex-direction:column}
}
@media(max-width:600px){
  .nav-links{display:none}
  .nav-logo{height:50px;width:87px}
  .hero-h1{font-size:32px}
  .hero-sub{font-size:15px}
  .pinturas-h2{font-size:36px}
  .obras-grid{grid-template-columns:1fr;gap:28px}
  .obra-cell--horizontal{grid-column:span 1}
  .bf-row{grid-template-columns:1fr}
  .footer-links{flex-direction:column;gap:32px}
}
</style>
</head>
<body>

<!-- HERO -->
<article>
<section class="hero" id="top" aria-label="Colecciones de Luma Arte">
  <img class="hero-bg" src="/img/hands.jpg" alt="Manos creando — pintura y bordado artesanal, Luma Arte" fetchpriority="high" decoding="async" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <nav class="nav" aria-label="Navegación principal">
    <a href="/" aria-label="Ir al inicio — Luma Arte">
      <img class="nav-logo" src="/img/luma-logo.png" alt="Luma Arte" />
    </a>
    <div class="nav-links">
      <a class="nav-link nav-link--active" href="/colecciones" aria-current="page">Colecciones</a>
      <a class="nav-link" href="/sobremi">Sobre mí</a>
      <a class="nav-link" href="/blog">Blog</a>
      <a class="nav-link" href="/#giftcards">Giftcard</a>
      <a class="nav-link" href="/#contacto">Contacto</a>
      <button class="nav-cart" id="btn-cart-shared" aria-label="Ver carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span id="cart-count-shared">(0)</span>
      </button>
    </div>
  </nav>
  <div class="hero-body">
    <p class="hero-eyebrow">Colecciones</p>
    <h1 class="hero-h1">Todo lo que creamos, <em>en un solo lugar</em>.</h1>
    <p class="hero-sub">Pinturas originales del sur de Chile y Foto Bordado — tu fotografía más importante, hecha bordado y enmarcada en madera nativa.</p>
  </div>
</section>

<!-- LA COLECCIÓN -->
<div id="pinturas" class="pinturas">
  <div class="pinturas-header">
    <div>
      <div class="pinturas-eyebrow">La colección</div>
      <h2 class="pinturas-h2">Obras&nbsp;<em>originales</em></h2>
      <p class="pinturas-sub">Cada pintura es única e irrepetible — técnica mixta en acuarela, pastel al óleo, acrílicos e hilo sobre papel de algodón.</p>
    </div>
  </div>
  <div class="obras-grid" id="obras-grid"></div>
</div>

<!-- FOTO BORDADO -->
<div id="foto-bordado" class="bordado">
  <div class="bordado-inner">
    <div>
      <div class="bordado-eyebrow">Nuevo</div>
      <h2 class="bordado-h2">Foto <em>Bordado</em></h2>
      <p class="bordado-sub">Envíanos una foto importante para ti. La imprimimos en tela en las medidas que solicites, creamos un diseño de bordado a partir de ella y la enmarcamos en madera nativa — una pieza única para siempre.</p>
      <div class="bordado-steps">
        <div class="bordado-step">
          <div class="bordado-step-num">1</div>
          <p class="bordado-step-txt"><strong>Nos envías tu foto</strong> — ese momento, esa persona o ese lugar que quieres tener presente.</p>
        </div>
        <div class="bordado-step">
          <div class="bordado-step-num">2</div>
          <p class="bordado-step-txt"><strong>La imprimimos en tela</strong>, en la medida que necesites.</p>
        </div>
        <div class="bordado-step">
          <div class="bordado-step-num">3</div>
          <p class="bordado-step-txt"><strong>Creamos el diseño de bordado</strong> a partir de tu fotografía.</p>
        </div>
        <div class="bordado-step">
          <div class="bordado-step-num">4</div>
          <p class="bordado-step-txt"><strong>La enmarcamos en madera nativa</strong>, en la especie que elijas.</p>
        </div>
      </div>
      <div class="bordado-maderas-label">Maderas nativas disponibles</div>
      <div class="bordado-maderas">
        <span class="bordado-madera">Mañío</span>
        <span class="bordado-madera">Laurel</span>
        <span class="bordado-madera">Coihue</span>
        <span class="bordado-madera">Roble</span>
      </div>
    </div>

    <div class="bordado-form">
      <div class="bordado-form-h3">Solicita tu cotización</div>
      <p class="bordado-form-sub">Cuéntanos qué tienes en mente. Te respondemos en menos de 24 horas y ahí coordinamos el envío de tu foto.</p>
      <form id="bordado-form">
        <div class="bf-row">
          <div class="bf-field">
            <label class="bf-label" for="bf-nombre">Tu nombre</label>
            <input class="bf-input" id="bf-nombre" name="nombre" required />
          </div>
          <div class="bf-field">
            <label class="bf-label" for="bf-email">Tu correo</label>
            <input class="bf-input" id="bf-email" name="email" type="email" required />
          </div>
        </div>
        <div class="bf-row">
          <div class="bf-field">
            <label class="bf-label" for="bf-tamano">Tamaño deseado</label>
            <input class="bf-input" id="bf-tamano" name="tamano" placeholder="Ej: 30 × 40 cm" />
          </div>
          <div class="bf-field">
            <label class="bf-label" for="bf-madera">Madera preferida</label>
            <select class="bf-select" id="bf-madera" name="madera">
              <option value="">Sin definir aún</option>
              <option value="Mañío">Mañío</option>
              <option value="Laurel">Laurel</option>
              <option value="Coihue">Coihue</option>
              <option value="Roble">Roble</option>
            </select>
          </div>
        </div>
        <div class="bf-field">
          <label class="bf-label" for="bf-mensaje">Cuéntanos sobre tu foto</label>
          <textarea class="bf-textarea" id="bf-mensaje" name="mensaje" rows="3" placeholder="Ej: es una foto de mi familia en el sur, quiero regalársela a mi mamá…"></textarea>
        </div>
        <button class="bf-submit" id="bf-submit" type="submit">Enviar solicitud de cotización →</button>
        <p class="bf-msg" id="bf-msg"></p>
      </form>
    </div>
  </div>
</div>
</article>

