---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth.js';
import { initDb } from '../../lib/db.js';

if (!isAuthenticated(Astro.request)) return Astro.redirect('/admin/login');

const db = await initDb();
const { rows } = await db.execute(
  "SELECT clave, valor FROM configuracion WHERE clave LIKE 'costo_%' ORDER BY clave"
);

const c = {};
for (const r of rows) c[r.clave] = r.valor ?? '';

function num(k) { return c[k] ? Number(c[k]) : null; }
function fmt(n) { return n !== null ? `$${n.toLocaleString('es-CL')}` : null; }
function total(keys) {
  const vals = keys.map(k => num(k));
  if (vals.some(v => v === null)) return null;
  return vals.reduce((a, b) => a + b, 0);
}

const tallas = [
  {
    key: 'A4',
    label: 'A4 con paspartú',
    print: '22 × 15 cm',
    frame: 'Marco A4 + paspartú 3cm',
    note: 'Precio Maderarte pendiente',
    impKey: 'costo_impresion_A4',
    enmKey: 'costo_enmarcado_A4',
  },
  {
    key: '30x40',
    label: '30 × 40 cm',
    print: '30 × 21 cm',
    frame: 'Marco 30×35 + paspartú 3cm (Maderarte)',
    note: null,
    impKey: 'costo_impresion_30x40',
    enmKey: 'costo_enmarcado_30x40',
  },
  {
    key: '40x50',
    label: '40 × 50 cm',
    print: 'pendiente',
    frame: 'Marco 40×50 + paspartú 3cm (Maderarte)',
    note: 'Costo impresión pendiente',
    impKey: 'costo_impresion_40x50',
    enmKey: 'costo_enmarcado_40x50',
  },
  {
    key: '50x70',
    label: '50 × 70 cm',
    print: 'pendiente',
    frame: 'Marco 50×70 + paspartú 3cm (Maderarte)',
    note: 'Ambos valores pendientes',
    impKey: 'costo_impresion_50x70',
    enmKey: 'costo_enmarcado_50x70',
  },
];
---
<AdminLayout title="Costos de producción" active="costos">
<style>
  .page-title{font-family:'Mackinac',serif;font-size:22px;font-weight:400;margin-bottom:8px}
  .page-sub{font-size:13px;color:rgba(33,31,24,.5);margin-bottom:28px}
  .info-box{background:#f5f0e8;border:.5px solid rgba(33,31,24,.12);border-radius:10px;padding:14px 18px;font-size:13px;color:rgba(33,31,24,.65);line-height:1.7;margin-bottom:28px}
  .info-box strong{color:#211f18}

  /* RESUMEN TABLE */
  .summary-card{background:#fdfcf8;border:.5px solid rgba(33,31,24,.1);border-radius:12px;overflow:hidden;margin-bottom:28px}
  .card-head{padding:15px 22px;border-bottom:.5px solid rgba(33,31,24,.08);display:flex;align-items:center;justify-content:space-between}
  .card-title{font-family:'Mackinac',serif;font-size:15px;font-weight:400}
  table{width:100%;border-collapse:collapse;font-size:13px}
  thead th{text-align:left;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(33,31,24,.4);padding:10px 16px;border-bottom:.5px solid rgba(33,31,24,.1);background:#faf8f4}
  thead th:not(:first-child){text-align:right}
  tbody td{padding:12px 16px;border-bottom:.5px solid rgba(33,31,24,.06);vertical-align:middle}
  tbody td:not(:first-child){text-align:right}
  tbody tr:last-child td{border-bottom:none}
  .tag-size{font-family:'Mackinac',serif;font-size:14px}
  .tag-print{font-size:11px;color:rgba(33,31,24,.4);margin-top:2px}
  .val-ok{font-weight:500;color:#211f18}
  .val-pending{font-size:11px;padding:2px 8px;background:rgba(180,130,30,.1);color:#7a5a10;border-radius:10px;white-space:nowrap}
  .val-total{font-weight:500;color:#54582f;font-size:14px}
  .val-total-pending{color:rgba(33,31,24,.3);font-size:12px}

  /* EDIT SECTION */
  .edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px}
  .talla-card{background:#fdfcf8;border:.5px solid rgba(33,31,24,.1);border-radius:12px;overflow:hidden}
  .talla-head{padding:14px 18px;border-bottom:.5px solid rgba(33,31,24,.08);display:flex;align-items:center;justify-content:space-between}
  .talla-label{font-family:'Mackinac',serif;font-size:14px;font-weight:400}
  .talla-frame{font-size:11px;color:rgba(33,31,24,.4)}
  .talla-body{padding:16px 18px}
  .field-row{display:flex;gap:12px;align-items:flex-end;margin-bottom:12px}
  .field-row:last-child{margin-bottom:0}
  .field-wrap{flex:1}
  .field-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:rgba(33,31,24,.45);margin-bottom:5px}
  .field-hint{font-size:10px;color:rgba(33,31,24,.35);margin-top:3px}
  .price-wrap{display:flex;align-items:center;gap:6px}
  .price-sym{font-size:16px;color:rgba(33,31,24,.35)}
  .price-input{width:100%;border:.5px solid rgba(33,31,24,.2);border-radius:7px;padding:8px 10px;font-size:16px;font-family:inherit;color:#211f18;background:#fff;outline:none;font-weight:300}
  .price-input:focus{border-color:#54582f}
  .price-input.pending{background:#fffbf3;border-color:rgba(180,130,30,.3)}
  .total-row{background:#f5f2ec;border-radius:7px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;margin-top:14px}
  .total-label{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:rgba(33,31,24,.45)}
  .total-val{font-family:'Mackinac',serif;font-size:16px;color:#54582f}
  .total-val.pending{font-size:12px;color:rgba(33,31,24,.35);font-family:inherit}

  .save-bar{background:#fdfcf8;border:.5px solid rgba(33,31,24,.1);border-radius:12px;padding:16px 20px;display:flex;gap:12px;align-items:center}
  .btn{padding:9px 22px;border-radius:8px;font-size:12px;font-family:inherit;cursor:pointer;transition:all .15s;letter-spacing:.04em}
  .btn-save{background:#54582f;border:.5px solid #54582f;color:#fdfcf8}
  .btn-save:hover{background:#3a3d1f}
  .status{font-size:12px;padding:6px 12px;border-radius:6px;display:none}
  .status.ok{background:#e8eddd;color:#3a4020;display:inline-block}
  .status.err{background:#fde8d8;color:#7a2010;display:inline-block}

  @media(max-width:900px){.edit-grid{grid-template-columns:1fr}}
</style>

<h1 class="page-title">Costos de <em>producción</em></h1>
<p class="page-sub">Impresión + enmarcado por talla. Solo visible internamente — no se muestran al cliente.</p>

<div class="info-box">
  <strong>Proveedor marcos:</strong> Maderarte Frutillar — Lista Mayorista 2026, todos con paspartú 3cm.<br>
  <strong>Impresión:</strong> valores propios por tamaño de obra.
</div>

<!-- RESUMEN -->
<div class="summary-card">
  <div class="card-head">
    <span class="card-title">Resumen por talla</span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Talla (enmarcada)</th>
        <th>Impresión</th>
        <th>Enmarcado</th>
        <th>Total costo</th>
      </tr>
    </thead>
    <tbody>
      {tallas.map(t => {
        const imp = num(t.impKey);
        const enm = num(t.enmKey);
        const tot = total([t.impKey, t.enmKey]);
        return (
          <tr>
            <td>
              <div class="tag-size">{t.label}</div>
              <div class="tag-print">Impresión {t.print}</div>
            </td>
            <td>{imp !== null ? <span class="val-ok">{fmt(imp)}</span> : <span class="val-pending">pendiente</span>}</td>
            <td>{enm !== null ? <span class="val-ok">{fmt(enm)}</span> : <span class="val-pending">pendiente</span>}</td>
            <td>{tot !== null ? <span class="val-total">{fmt(tot)}</span> : <span class="val-total-pending">—</span>}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<!-- EDICIÓN POR TALLA -->
<div class="edit-grid">
  {tallas.map(t => {
    const imp = c[t.impKey] ?? '';
    const enm = c[t.enmKey] ?? '';
    const impN = imp ? Number(imp) : null;
    const enmN = enm ? Number(enm) : null;
    const tot = (impN !== null && enmN !== null) ? impN + enmN : null;
    return (
      <div class="talla-card">
        <div class="talla-head">
          <span class="talla-label">{t.label}</span>
          <span class="talla-frame">{t.frame}</span>
        </div>
        <div class="talla-body">
          <div class="field-row">
            <div class="field-wrap">
              <div class="field-label">Costo impresión</div>
              <div class="price-wrap">
                <span class="price-sym">$</span>
                <input
                  class={`price-input${!imp ? ' pending' : ''}`}
                  type="number"
                  id={`imp-${t.key}`}
                  value={imp}
                  min="0"
                  step="1"
                  placeholder="pendiente"
                  oninput={`recalc('${t.key}')`}
                />
              </div>
              <div class="field-hint">Impresión {t.print}</div>
            </div>
          </div>
          <div class="field-row">
            <div class="field-wrap">
              <div class="field-label">Costo enmarcado (Maderarte)</div>
              <div class="price-wrap">
                <span class="price-sym">$</span>
                <input
                  class={`price-input${!enm ? ' pending' : ''}`}
                  type="number"
                  id={`enm-${t.key}`}
                  value={enm}
                  min="0"
                  step="100"
                  placeholder="pendiente"
                  oninput={`recalc('${t.key}')`}
                />
              </div>
              {t.note && <div class="field-hint" style="color:#c5960a">{t.note}</div>}
            </div>
          </div>
          <div class="total-row">
            <span class="total-label">Total costo</span>
            <span class={`total-val${tot === null ? ' pending' : ''}`} id={`tot-${t.key}`}>
              {tot !== null ? fmt(tot) : '—'}
            </span>
          </div>
        </div>
      </div>
    );
  })}
</div>

<div class="save-bar">
  <button class="btn btn-save" onclick="guardar()">Guardar todos los costos</button>
  <span class="status" id="status-msg"></span>
</div>

<script define:vars={{ tallas }}>
function recalc(key) {
  const impEl = document.getElementById('imp-' + key);
  const enmEl = document.getElementById('enm-' + key);
  const totEl = document.getElementById('tot-' + key);
  const imp = impEl && impEl.value ? Number(impEl.value) : null;
  const enm = enmEl && enmEl.value ? Number(enmEl.value) : null;
  if (imp !== null && enm !== null) {
    const tot = imp + enm;
    totEl.textContent = '$' + tot.toLocaleString('es-CL');
    totEl.className = 'total-val';
  } else {
    totEl.textContent = '—';
    totEl.className = 'total-val pending';
  }
}

window.recalc = recalc;

function showStatus(msg, ok) {
  const el = document.getElementById('status-msg');
  el.textContent = msg;
  el.className = 'status ' + (ok ? 'ok' : 'err');
  setTimeout(() => { el.className = 'status'; }, 4000);
}

async function guardar() {
  const body = {};
  for (const t of tallas) {
    const impEl = document.getElementById('imp-' + t.key);
    const enmEl = document.getElementById('enm-' + t.key);
    if (impEl) body[t.impKey] = impEl.value.trim();
    if (enmEl) body[t.enmKey] = enmEl.value.trim();
  }

  const res = await fetch('/api/admin/costos-save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await res.json();
  if (data.ok) {
    showStatus('✓ Costos actualizados.', true);
    setTimeout(() => location.reload(), 1200);
  } else {
    showStatus('Error: ' + (data.error || 'desconocido'), false);
  }
}

window.guardar = guardar;
</script>
</AdminLayout>
