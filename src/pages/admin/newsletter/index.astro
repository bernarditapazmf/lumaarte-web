---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../../lib/auth.js';
import { initDb } from '../../../lib/db.js';

if (!isAuthenticated(Astro.request)) return Astro.redirect('/admin/login');

const db = await initDb();
const { rows: campanas } = await db.execute(
  'SELECT * FROM campanas ORDER BY created_at DESC'
);
const { rows: subs } = await db.execute(
  "SELECT COUNT(*) as total FROM contactos WHERE origen='newsletter' OR tags LIKE '%suscriptor%'"
);
const totalSubs = subs[0]?.total ?? 0;
---
<AdminLayout title="Newsletter" active="newsletter">
  <style>
    .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}
    h1{font-family:'Mackinac',serif;font-size:26px;font-weight:400}
    h1 em{font-style:italic}
    .btn-new{display:inline-flex;align-items:center;gap:6px;background:#54582f;color:#fdfcf8;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12px;letter-spacing:.04em}
    .btn-new:hover{background:#3a3d1f}
    .stat-row{display:flex;gap:14px;margin-bottom:28px}
    .stat{background:#fdfcf8;border:.5px solid rgba(33,31,24,.1);border-radius:10px;padding:18px 20px;min-width:140px}
    .stat-num{font-family:'Mackinac',serif;font-size:28px;font-weight:400;line-height:1;margin-bottom:4px}
    .stat-label{font-size:10px;color:rgba(33,31,24,.45);letter-spacing:.06em;text-transform:uppercase}
    .table-wrap{background:#fdfcf8;border:.5px solid rgba(33,31,24,.1);border-radius:10px;overflow:hidden}
    table{width:100%;border-collapse:collapse}
    th{text-align:left;padding:10px 16px;font-size:10px;letter-spacing:.08em;color:rgba(33,31,24,.4);border-bottom:.5px solid rgba(33,31,24,.08);font-weight:400;text-transform:uppercase}
    td{padding:12px 16px;border-bottom:.5px solid rgba(33,31,24,.06);font-size:13px;vertical-align:middle}
    tr:last-child td{border-bottom:none}
    tr:hover td{background:#faf9f5}
    .badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:10px}
    .badge-borrador{background:#f5f0e8;color:#7a6030}
    .badge-enviado{background:#e8eddd;color:#3a4020}
    .actions{display:flex;gap:6px}
    .btn-edit{font-size:11px;color:#54582f;text-decoration:none;padding:4px 10px;border:.5px solid rgba(84,88,47,.35);border-radius:5px}
    .btn-edit:hover{background:#54582f;color:#fdfcf8}
    .btn-del{font-size:11px;color:#a33;background:none;border:.5px solid rgba(170,51,51,.3);border-radius:5px;padding:4px 10px;cursor:pointer;font-family:inherit}
    .btn-del:hover{background:#a33;color:#fff}
    .empty{text-align:center;padding:48px 20px;color:rgba(33,31,24,.4);font-size:13px}
  </style>

  <div class="page-header">
    <h1>News<em>letter</em></h1>
    <a class="btn-new" href="/admin/newsletter/nueva">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Nueva campaña
    </a>
  </div>

  <div class="stat-row">
    <div class="stat">
      <div class="stat-num">{totalSubs}</div>
      <div class="stat-label">Suscriptores</div>
    </div>
    <div class="stat">
      <div class="stat-num">{campanas.filter(c => c.estado === 'enviado').length}</div>
      <div class="stat-label">Campañas enviadas</div>
    </div>
    <div class="stat">
      <div class="stat-num">{campanas.reduce((s, c) => s + Number(c.enviados || 0), 0)}</div>
      <div class="stat-label">Correos enviados</div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Asunto</th>
          <th>Estado</th>
          <th>Enviados</th>
          <th>Fecha</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {campanas.length === 0
          ? <tr><td colspan="5" class="empty">Aún no hay campañas. Crea la primera →</td></tr>
          : campanas.map(c => (
            <tr>
              <td style="font-weight:400">{c.asunto}</td>
              <td><span class={`badge badge-${c.estado}`}>{c.estado}</span></td>
              <td>{c.enviados ?? 0}</td>
              <td style="color:rgba(33,31,24,.45);font-size:12px">{c.created_at?.slice(0,10)}</td>
              <td class="actions">
                <a class="btn-edit" href={`/admin/newsletter/nueva?id=${c.id}`}>Editar</a>
                <button class="btn-del" data-id={c.id} onclick="del(this)">Eliminar</button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
async function del(btn) {
  if (!confirm('¿Eliminar esta campaña?')) return;
  const id = btn.dataset.id;
  await fetch('/api/admin/campana-delete', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ id }) });
  location.reload();
}
window.del = del;
</script>
