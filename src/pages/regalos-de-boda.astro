export const prerender = true;
import CartDrawer from '../components/CartDrawer.astro';
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Regalos de Boda Originales — Pinturas del Sur de Chile | Luma Arte</title>
<meta name="description" content="El regalo de boda que no se olvida: una pintura original del sur de Chile en técnica mixta. Acuarela, pastel al óleo y bordado a mano. Con paspartú artesanal en madera nativa. Envíos a todo Chile." />
<link rel="canonical" href="https://www.lumaarte.com/regalos-de-boda" />
